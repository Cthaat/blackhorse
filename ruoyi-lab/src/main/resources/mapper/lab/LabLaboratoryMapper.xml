<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.lab.mapper.LabLaboratoryMapper">

    <resultMap id="LabLaboratoryResult" type="com.ruoyi.lab.domain.LabLaboratory">
        <id property="id" column="id" />
        <result property="labCode" column="lab_code" />
        <result property="name" column="name" />
        <result property="deptId" column="dept_id" />
        <result property="managerId" column="manager_id" />
        <result property="location" column="location" />
        <result property="description" column="description" />
        <result property="status" column="status" />
        <result property="version" column="version" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="delFlag" column="del_flag" />
    </resultMap>

    <sql id="LaboratoryColumns">
        l.id, l.lab_code, l.name, l.dept_id, l.manager_id, l.location,
        l.description, l.status, l.version, l.create_by, l.create_time,
        l.update_by, l.update_time, l.del_flag
    </sql>

    <sql id="LaboratoryScopePredicate">
        <choose>
            <when test="scope != null and scope.allLaboratories">
                <!-- unrestricted scope -->
            </when>
            <when test="scope != null and scope.restricted() and scope.laboratoryIds != null and !scope.laboratoryIds.isEmpty()">
                and l.id in
                <foreach collection="scope.laboratoryIds" item="scopeLaboratoryId" open="(" separator="," close=")">
                    #{scopeLaboratoryId}
                </foreach>
            </when>
            <otherwise>
                and 1 = 0
            </otherwise>
        </choose>
    </sql>

    <select id="selectListByScope" resultMap="LabLaboratoryResult">
        select <include refid="LaboratoryColumns" />
        from lab_laboratory l
        where l.del_flag = '0'
        <include refid="LaboratoryScopePredicate" />
        <if test="status != null">
            and l.status = #{status}
        </if>
        <if test="keyword != null and keyword != ''">
            and (l.lab_code like concat('%', #{keyword}, '%')
                or l.name like concat('%', #{keyword}, '%')
                or l.location like concat('%', #{keyword}, '%'))
        </if>
        <choose>
            <when test="sort != null">
                order by ${sort.column} ${sort.direction}
            </when>
            <otherwise>
                order by l.create_time desc
            </otherwise>
        </choose>
    </select>

    <select id="selectByIdInScope" resultMap="LabLaboratoryResult">
        select <include refid="LaboratoryColumns" />
        from lab_laboratory l
        where l.id = #{laboratoryId}
          and l.del_flag = '0'
        <include refid="LaboratoryScopePredicate" />
    </select>

    <select id="selectByIdForUpdate" resultMap="LabLaboratoryResult">
        select <include refid="LaboratoryColumns" />
        from lab_laboratory l
        where l.id = #{laboratoryId}
          and l.del_flag = '0'
        for update
    </select>

    <update id="updateDetailsConditionally">
        update lab_laboratory
        set lab_code = #{laboratory.labCode},
            name = #{laboratory.name},
            dept_id = #{laboratory.deptId},
            manager_id = #{laboratory.managerId},
            location = #{laboratory.location},
            description = #{laboratory.description},
            update_by = #{laboratory.updateBy},
            version = version + 1
        where id = #{laboratory.id}
          and version = #{expectedVersion}
          and del_flag = '0'
    </update>

</mapper>
