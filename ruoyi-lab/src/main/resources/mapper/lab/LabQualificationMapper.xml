<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.lab.mapper.LabQualificationMapper">

    <resultMap id="LabQualificationResult" type="com.ruoyi.lab.domain.LabQualification">
        <id property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="scopeType" column="scope_type" />
        <result property="scopeId" column="scope_id" />
        <result property="validFrom" column="valid_from" />
        <result property="validUntil" column="valid_until" />
        <result property="revokedAt" column="revoked_at" />
        <result property="revokeReason" column="revoke_reason" />
        <result property="version" column="version" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="delFlag" column="del_flag" />
    </resultMap>

    <sql id="QualificationColumns">
        q.id, q.user_id, q.scope_type, q.scope_id, q.valid_from, q.valid_until,
        q.revoked_at, q.revoke_reason, q.version, q.create_by, q.create_time,
        q.update_by, q.update_time, q.del_flag
    </sql>

</mapper>
